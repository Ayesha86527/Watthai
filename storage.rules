rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Bill images - users can only upload/access their own
    match /bills/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024  // 5MB limit
                   && request.resource.contentType.matches('image/.*');
    }

    // Outage photos - authenticated users can upload
    match /outages/{outageId}/{fileName} {
      allow read: if true;  // Public read for community visibility
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
