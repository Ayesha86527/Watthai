rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userIdField) {
      return isAuthenticated() && request.auth.uid == resource.data[userIdField];
    }

    function isOwnerCreate() {
      return isAuthenticated() && request.auth.uid == request.resource.data.user_id;
    }

    // Users collection - users can read all, update only their own
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Bills collection - users can only access their own bills
    match /bills/{billId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.user_id;
      allow create: if isOwnerCreate();
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.user_id;
    }

    // Outages collection - public read, authenticated create
    match /outages/{outageId} {
      allow read: if true;  // Public read for community dashboard
      allow create: if isAuthenticated();
      allow update, delete: if false;  // Only server admin can update
    }

    // Outage reports collection - users can create, read is restricted
    match /outageReports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    // Restoration polls - authenticated users can vote
    match /restorationPolls/{pollId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    // News items - public read, only server can write
    match /newsItems/{newsId} {
      allow read: if true;  // Public read for news feed
      allow write: if false;  // Only server/cloud functions can write
    }

    // Zone benchmarks - public read for comparison
    match /zoneBenchmarks/{benchmarkId} {
      allow read: if true;  // Public read for benchmarking
      allow write: if false;  // Only server can write
    }
  }
}
