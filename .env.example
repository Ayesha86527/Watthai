# Get your API key from: https://newsdata.io/ (free tier: 200 credits/day)
# -----------------------------------------------------------------------------
NEWSDATA_API_KEY="pub_e04239f1ee6b43fb91eaac61fe715ee8"

# -----------------------------------------------------------------------------
# CRON SECRET (Required for scheduled tasks)
# Generate a random secure string for this
# Use: openssl rand -hex 32 or any password generator
