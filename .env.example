NEXT_PUBLIC_GEMINI_API_KEY="AIzaSyCPqnen2JrcLTUbojE9p3seZaCxIUv-5zI"

# -----------------------------------------------------------------------------
# FIREBASE WEB CLIENT CONFIG (Required for client-side operations)
# Get these from: Firebase Console > Project Settings > General > Your apps
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_PROJECT_ID="talent-482612"
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyCkQSjafPqvDms4gWdl3kq-5OzldB-zO7E"
