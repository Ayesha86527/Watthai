NEXT_PUBLIC_FIREBASE_APP_ID="1:1021690391550:web:c7d4d0880c7fbac2ecaeaf"

# Firestore Database ID (from firebase-applet-config.json)
NEXT_PUBLIC_FIRESTORE_DATABASE_ID="ai-studio-90ecc394-356a-4960-bf14-edea5a63d18e"

# -----------------------------------------------------------------------------
# FIREBASE ADMIN SDK (Required for server-side operations)
# Option 1: Service Account Key File (recommended for local/production)
# Download from: Firebase Console > Project Settings > Service Accounts > Generate new private key
# Save the JSON file as service-account-key.json in the project root
# -----------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS="./service-account-key.json"
GOOGLE_CLOUD_PROJECT_ID="talent-482612"

# Option 2: Service Account JSON as environment variable (for platforms like Cloud Run)
# Paste the entire service account JSON content here (single line, escaped)
# FIREBASE_ADMIN_SDK_JSON='{"type":"service_account","project_id":"..."}'

# -----------------------------------------------------------------------------
# FIREBASE CLOUD MESSAGING (Optional - for push notifications)
# Get VAPID key from: Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FCM_VAPID_KEY="BDUIRiVuVbbrSm3hcxWwI1yNNtJc7mVu5A8mRDKKrP-DbpkuTFZZIu2wnV2v-MAGAIYEL0wSCF9MOil1aROMlUI"

# -----------------------------------------------------------------------------
